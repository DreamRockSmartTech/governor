{
  "workspace": [
    "./core",
    "./cli",
    "./meta",
    "./skill"
  ],
  "tasks": {
    "check": "deno check core/ cli/ meta/ skill/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A '**/*.unit.ts' '**/*.e2e.ts'",
    "gov": "deno run -A cli/mod.ts"
  },
  "test": {
    "include": ["**/*.unit.ts", "**/*.e2e.ts"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": ["**/tests/testdata/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["**/tests/testdata/"]
  }
}
